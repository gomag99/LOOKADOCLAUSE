{
  "manifest_version": 3,
  "name": "LOOKADCLAUSE!!",
  "version": "0.1.0",
  "description": "広告やポップアップの閉じるボタンを目立たせる（ブロックはしない）",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
